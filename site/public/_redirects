# Cloudflare Pages redirects.
# The docs live at root paths (/concepts/, /provider-backends/, …), but "/docs"
# is the obvious guess — and the nav labels it "Docs" — so send it to the
# concepts guide rather than 404.
/docs      /concepts/  301
/docs/*    /concepts/  301

# No rule for /install. It is the install docs overview (/install/index.html),
# which is what someone typing that URL into a browser expects — and a static
# asset shadows a redirect on Pages anyway, so a rewrite here would be silently
# inert. The installer is served from its real path: /install.sh.

# The honeycomb credential driver was removed in v0.20.0 — its keys were wrong on
# the wire and could be neither revoked nor expired. Keep the key in a vault and
# chain it through the apikey driver instead. (The honeycomb *provider* is
# unaffected and keeps its own page.)
/credential-drivers/honeycomb   /credential-drivers/apikey   301
